{
  "schema_version": 1,
  "name": "dropbear-win",
  "transport": "stdio",
  "location": "client-side",
  "entrypoint": "dropbear_mcp.py",
  "requirements": "requirements-mcp.txt",
  "installation_guide": "agent-mcp.md",
  "bundle_manifest": "bundle-manifest.json",
  "python": ">=3.10",
  "auto_install": false,
  "environment": ["DROPBEAR_MCP_HOST", "DROPBEAR_MCP_USER", "DROPBEAR_MCP_PASSWORD"],
